	keywords = {Physics - Plasma Physics, Physics - Computational Physics},
	file = {Preprint PDF:C\:\\Users\\yigit\\Zotero\\storage\\JTMPBHBE\\Balkovic et al. - 2026 - SPECTRE A robust solver for 3D equilibria with arbitrary topology.pdf:application/pdf;Snapshot:C\:\\Users\\yigit\\Zotero\\storage\\Y5QLK598\\2607.html:text/html},
}

@article{babin_construction_2025,
	title = {Construction of an invertible mapping to boundary conforming coordinates for arbitrarily shaped toroidal domains},
	volume = {67},
	issn = {0741-3335},
	url = {https://doi.org/10.1088/1361-6587/adaee6},
	doi = {10.1088/1361-6587/adaee6},
	abstract = {Boundary conforming coordinates are commonly used in plasma physics to describe the geometry of toroidal domains, for example, in three-dimensional magnetohydrodynamic equilibrium solvers. The magnetohydrodynamic equilibrium configuration can be approximated with an inverse map, defining nested surfaces of constant magnetic flux. For equilibrium solvers that solve for this inverse map iteratively, the initial guess for the inverse map must be well-defined and invertible. Even if magnetic islands are to be included in the representation, boundary conforming coordinates can still be useful, for example to parametrize the interface surfaces in multi-region, relaxed magnetohydrodynamics or as a general-purpose, field-agnostic coordinate system in strongly shaped domains. Given a fixed boundary shape, finding a valid boundary conforming mapping can be challenging, especially for the non-convex boundaries from recent developments in stellarator optimization. In this work, we propose a new algorithm to construct such a mapping, by solving two Dirichlet–Laplace problems via a boundary integral method. We can prove that the generated harmonic map is always smooth and has a smooth inverse. Furthermore, we can find a discrete approximation of the mapping that preserves this property.},
	language = {en},
	number = {3},
	urldate = {2026-09-08},
	journal = {Plasma Physics and Controlled Fusion},
	publisher = {IOP Publishing},
	author = {Babin, Robert and Hindenlang, Florian and Maj, Omar and Köberl, Robert},
	month = feb,
	year = {2025},
	pages = {035005},
	file = {IOP Full Text PDF:C\:\\Users\\yigit\\Zotero\\storage\\VKCBYGT4\\Babin et al. - 2025 - Construction of an invertible mapping to boundary conforming coordinates for arbitrarily shaped toro.pdf:application/pdf},
}

