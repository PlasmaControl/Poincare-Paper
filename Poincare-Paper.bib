@article{conlinDESCStellaratorCode2023a,
	title = {The {DESC} stellarator code suite. {Part} 2. {Perturbation} and continuation methods},
	volume = {89},
	issn = {0022-3778, 1469-7807},
	url = {https://www.cambridge.org/core/journals/journal-of-plasma-physics/article/desc-stellarator-code-suite-part-2-perturbation-and-continuation-methods/5766F6B713EC93D438A35705F2C1E861},
	doi = {10.1017/S0022377823000399},
	abstract = {A new perturbation and continuation method is presented for computing and analysing stellarator equilibria. The method is formally derived from a series expansion about the equilibrium condition F≡J×B−∇p=0F≡J×B−∇p=0{\textbackslash}boldsymbol \{F\} {\textbackslash}equiv {\textbackslash}boldsymbol \{J\}{\textbackslash}times {\textbackslash}boldsymbol \{B\} - {\textbackslash}boldsymbol \{{\textbackslash}nabla \} p = 0, and an efficient algorithm for computing solutions to second- and third-order perturbations is developed. The method has been implemented in the DESC stellarator equilibrium code, using automatic differentiation to compute the required derivatives. Examples are shown demonstrating its use for computing complicated equilibria, perturbing a tokamak into a stellarator and performing parameter scans in pressure, rotational transform and boundary shape in a fraction of the time required for a full solution.},
	language = {en},
	number = {3},
	urldate = {2026-01-13},
	journal = {Journal of Plasma Physics},
	author = {Conlin, Rory and Dudt, Daniel W. and Panici, Dario and Kolemen, Egemen},
	month = jun,
